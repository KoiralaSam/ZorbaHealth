<div style="font-family:Segoe UI,Helvetica,Arial,sans-serif;max-width:560px;margin:0 auto;color:#0f172a;line-height:1.5;">
  <div style="background:#0f172a;color:#fff;border-radius:16px 16px 0 0;padding:24px 28px;">
    <p style="margin:0;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.85;">Zorba Health · Clinician</p>
    <h1 style="margin:8px 0 0;font-size:22px;font-weight:700;">Patient appointment booked</h1>
  </div>
  <div style="border:1px solid #e2e8f0;border-top:none;border-radius:0 0 16px 16px;padding:24px 28px;background:#ffffff;">
    <p style="margin:0 0 16px;">Hello {{ .StaffName }},</p>
    <p style="margin:0 0 20px;">A visit is confirmed on your schedule.</p>
    <table role="presentation" style="width:100%;border-collapse:collapse;margin:0 0 20px;">
      <tr>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;color:#64748b;width:38%;">When</td>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;font-weight:600;">{{ .StartLocal }}<br/><span style="font-weight:400;color:#64748b;font-size:13px;">{{ .Timezone }} · {{ .DurationMinutes }} min</span></td>
      </tr>
      <tr>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Patient</td>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;font-weight:600;">{{ .PatientName }}</td>
      </tr>
      <tr>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Hospital</td>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;font-weight:600;">{{ .HospitalName }}{{ if .HospitalAddress }}<br/><span style="font-weight:400;color:#475569;font-size:13px;">{{ .HospitalAddress }}</span>{{ end }}</td>
      </tr>
      <tr>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Visit type</td>
        <td style="padding:10px 0;border-bottom:1px solid #f1f5f9;font-weight:600;">{{ .TypeLabel }}</td>
      </tr>
    </table>
    <div style="display:flex;flex-wrap:wrap;gap:10px;">
      {{ if .MapsURL }}
      <a href="{{ .MapsURL }}" style="display:inline-block;background:#0f766e;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 18px;border-radius:999px;">Open in Google Maps</a>
      {{ end }}
      {{ if .JoinURL }}
      <a href="{{ .JoinURL }}" style="display:inline-block;background:#0f172a;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 18px;border-radius:999px;">Join video visit</a>
      {{ end }}
    </div>
    <p style="margin:24px 0 0;font-size:13px;color:#94a3b8;">— Zorba Health</p>
  </div>
</div>
