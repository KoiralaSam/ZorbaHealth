# Copy to .env.local and fill in values.
# LIVEKIT_AGENT_NAME must match the SIP dispatch rule (zorba-health-voice).
#
# Host Docker LiveKit sidecar (deploy/docker/livekit/):
#   - from minikube pods: ws://host.minikube.internal:7880
#   - from the host / local process: ws://localhost:7880

LIVEKIT_URL=ws://host.minikube.internal:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=zorba-health-voice

# MCP server (Tilt forwards mcp-server to localhost:8092)
MCP_SERVER_URL=http://localhost:8092
PATIENT_SERVICE_JWT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
ENABLE_TURN_DETECTOR=false
# Production/SIP: keep true so empty LiveKit jobs do not burn OpenAI on the greeting.
# Local `agent.py dev` (no SIP identity): set false.
VOICE_AGENT_REQUIRE_SIP_CALLER=true
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# LiveKit worker pool (production `start` mode)
VOICE_AGENT_NUM_IDLE_PROCESSES=1
VOICE_AGENT_LOAD_THRESHOLD=0.75
VOICE_AGENT_SHUTDOWN_PROCESS_TIMEOUT=30
VOICE_AGENT_INITIALIZE_PROCESS_TIMEOUT=45
