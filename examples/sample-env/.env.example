# Zorba Health sample environment file
# Copy values into your local secret or environment management workflow.

# Core infrastructure
DATABASE_URL=postgres://healthai:REPLACE_POSTGRES_PASSWORD@postgres:5432/healthai?sslmode=disable
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
INTERNAL_SERVICE_SECRET=REPLACE_WITH_INTERNAL_SERVICE_SECRET

# Public entrypoints
API_GATEWAY_HTTP_ADDR=:8081
PUBLIC_WEB_BASE_URL=http://localhost:3000

# Service addresses
AUTH_SERVICE_GRPC_ADDR=auth-service:9092
PATIENT_SERVICE_GRPC_ADDR=patient-service:9093
HEALTH_RECORDS_SERVICE_GRPC_ADDR=health-records-service:50054
MEDICAL_RECORDS_SERVICE_GRPC_ADDR=health-records-service:50054
ANALYTICS_SERVICE_GRPC_ADDR=analytics-service:50054
LOCATION_SERVICE_GRPC_ADDR=location-service:50051
LOCATION_SERVICE_HTTP_ADDR=:8090
TRANSLATION_SERVICE_GRPC_ADDR=:50057
AGENT_WORKER_HTTP_ADDR=:8090

# Auth and JWT
AUTH_SERVICE_JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET
PATIENT_SERVICE_JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET

# Provider selection hints
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
SPEECH_TO_TEXT_PROVIDER=deepgram
TEXT_TO_SPEECH_PROVIDER=elevenlabs
EMAIL_PROVIDER=sendgrid
SMS_PROVIDER=voipms
TRANSLATION_PROVIDER=local-llamacpp
VECTOR_SEARCH_PROVIDER=postgres-pgvector
FHIR_PROVIDER=internal
TELEPHONY_PROVIDER=livekit-sip

# LLM and embeddings
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Speech providers
DEEPGRAM_API_KEY=REPLACE_WITH_DEEPGRAM_API_KEY
ELEVENLABS_API_KEY=REPLACE_WITH_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=REPLACE_WITH_ELEVENLABS_VOICE_ID

# Telephony and real-time media
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET

# Notification providers
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=replace-with-verified-sender@example.com
SENDGRID_FROM_NAME=ZorbaHealth
VOIPMS_API_USERNAME=REPLACE_VOIPMS_USERNAME
VOIPMS_API_PASSWORD=REPLACE_VOIPMS_PASSWORD
VOIPMS_DID=REPLACE_VOIPMS_DID
VOIPMS_API_KEY=REPLACE_VOIPMS_API_KEY
VOIPMS_API_BASEURL=https://voip.ms/api/v1/rest.php

# Location and geolocation
IP_GEOLOCATION_ENDPOINT_TEMPLATE=https://REPLACE_GEO_PROVIDER_ENDPOINT/%s

# Translation model backend
TRANSLATION_MODEL_BASE_URL=http://translation-model:8080

# MCP
MCP_SERVER_BINARY=/app/mcp-server
